# ─────────────────────────────────────────────────────────────
# Capital Humano — variables de entorno
# Copiar a .env y ajustar valores:  cp .env.example .env
# .env NUNCA se sube al repositorio (ver .gitignore).
# ─────────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=django-insecure-cambiar-en-produccion-por-una-clave-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Base de datos (PostgreSQL) ──────────────────
POSTGRES_DB=capital_humano_db
POSTGRES_USER=ch_user
POSTGRES_PASSWORD=ch_password_cambiar
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Redis / Celery ────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Superusuario inicial (se crea solo si no existe) ─────────
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@capitalhumano.local
DJANGO_SUPERUSER_PASSWORD=cambiar_esta_contrasena

# ── CORS / CSRF (producción) ──────────────────────────────────
CORS_ALLOWED_ORIGINS=
DJANGO_CSRF_TRUSTED_ORIGINS=
